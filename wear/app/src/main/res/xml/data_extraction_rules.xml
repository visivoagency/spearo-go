<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The "auth" prefs hold the Firebase refresh token: never in cloud
     backup, never carried to a new device. Everything else backs up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>
